---
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';
import { locText, type Lang } from '../i18n/utils';
import SiteLayout from '../layouts/SiteLayout.astro';
import { byOrder } from '../lib/sort';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = byOrder(await getCollection('beyond')).map((e) => ({
  kind: e.data.kind,
  ...locText(e.data.en, e.data.ko, lang),
}));
const values = all.filter((e) => e.kind === 'value');
const hobbies = all.filter((e) => e.kind === 'hobby');
const tastes = all.filter((e) => e.kind === 'taste');
---

<SiteLayout lang={lang} tab="beyond" title={t(lang, 'nav.beyond')}>
  <h1 class="page-title">{t(lang, 'nav.beyond')}</h1>
  {
    values.length > 0 && (
      <section>
        <div class="label">
          <span>{t(lang, 'values')}</span>
        </div>
        <ul class="values">
          {values.map((v) => (
            <li>
              <span class="value-title">{v.title}</span>
              {v.detail && <span class="value-detail">{v.detail}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    (hobbies.length > 0 || tastes.length > 0) && (
      <div class="beyond-cols">
        {hobbies.length > 0 && (
          <section>
            <div class="label">
              <span>{t(lang, 'hobbies')}</span>
            </div>
            <ul class="hobbies">
              {hobbies.map((h) => (
                <li>{h.title}</li>
              ))}
            </ul>
          </section>
        )}
        {tastes.length > 0 && (
          <section>
            <div class="label">
              <span>{t(lang, 'tastes')}</span>
            </div>
            <dl class="tastes">
              {tastes.map((x) => (
                <>
                  <dt>{x.title}</dt>
                  <dd>{x.detail}</dd>
                </>
              ))}
            </dl>
          </section>
        )}
      </div>
    )
  }
</SiteLayout>
