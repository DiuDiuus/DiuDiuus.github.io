---
import { getCollection } from 'astro:content';
import Toggle from '../components/Toggle.astro';
import { t } from '../i18n/ui';
import { locText, tabPath, type Lang } from '../i18n/utils';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatPeriod } from '../lib/dates';
import { byStartDesc } from '../lib/sort';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = byStartDesc(await getCollection('experience'));
const projects = new Map(
  (await getCollection('projects')).map((p) => [p.id, locText(p.data.en, p.data.ko, lang).title]),
);
---

<SiteLayout lang={lang} tab="experience" title={t(lang, 'experienceTitle')}>
  <h1 class="page-title">{t(lang, 'experienceTitle')}</h1>
  {
    items.map((entry) => {
      const d = entry.data;
      const text = locText(d.en, d.ko, lang);
      const related = d.projects.filter((id) => projects.has(id));
      return (
        <Toggle id={entry.id}>
          <Fragment slot="summary">
            <span class="s-title">{text.role}</span>
            <span class="s-meta">
              {text.org ?? d.org} · {formatPeriod(d.start, d.end, lang)}
            </span>
          </Fragment>
          {text.detail && <p class="s-lead">{text.detail}</p>}
          {d.location && <p class="muted">{d.location}</p>}
          {related.length > 0 && (
            <>
              <div class="label">
                <span>{t(lang, 'related')}</span>
              </div>
              <ul class="related">
                {related.map((id) => (
                  <li>
                    <a href={`${tabPath('projects', lang)}#${id}`}>{projects.get(id)}</a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </Toggle>
      );
    })
  }
</SiteLayout>
