---
import { getCollection } from 'astro:content';
import ExperienceItem from '../components/ExperienceItem.astro';
import { t } from '../i18n/ui';
import { locText, type Lang } from '../i18n/utils';
import SiteLayout from '../layouts/SiteLayout.astro';
import { byStartDesc } from '../lib/sort';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = byStartDesc(await getCollection('experience'));
const work = items.filter((e) => e.data.kind === 'work');
const education = items.filter((e) => e.data.kind === 'education');
const projectTitles = new Map(
  (await getCollection('projects')).map((p) => [p.id, locText(p.data.en, p.data.ko, lang).title]),
);
---

<SiteLayout lang={lang} tab="experience" title={t(lang, 'experienceTitle')}>
  <h1 class="page-title">{t(lang, 'experienceTitle')}</h1>
  {
    work.length > 0 && (
      <section>
        <h2 class="section-title">{t(lang, 'work')}</h2>
        {work.map((entry) => (
          <ExperienceItem entry={entry} lang={lang} projectTitles={projectTitles} />
        ))}
      </section>
    )
  }
  {
    education.length > 0 && (
      <section>
        <h2 class="section-title">{t(lang, 'education')}</h2>
        {education.map((entry) => (
          <ExperienceItem entry={entry} lang={lang} projectTitles={projectTitles} />
        ))}
      </section>
    )
  }
</SiteLayout>
