---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/dm-sans';
import '@fontsource/gowun-batang/400.css';
import '@fontsource/gowun-batang/700.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';

import { getCollection, getEntry } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { pick, tabPath, type Lang, type Tab } from '../i18n/utils';

interface Props {
  lang: Lang;
  tab: Tab;
  title: string;
}
const { lang, tab, title } = Astro.props;

const profileEntry = await getEntry('profile', 'main');
if (!profileEntry) throw new Error('src/content/profile.yaml must define `main`');
const profile = profileEntry.data;
const hasBeyond = (await getCollection('beyond')).length > 0;

const description = pick(profile.tagline, lang);
const fullTitle = `${title} — ${pick(profile.name, lang)}`;
const site = Astro.site ?? new URL('https://diudiuus.github.io');
const url = (path: string) => new URL(path, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={url(tabPath(tab, lang))} />
    <link rel="alternate" hreflang="en" href={url(tabPath(tab, 'en'))} />
    <link rel="alternate" hreflang="ko" href={url(tabPath(tab, 'ko'))} />
    <link rel="alternate" hreflang="x-default" href={url(tabPath(tab, 'en'))} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(tabPath(tab, lang))} />
    <meta property="og:image" content={url('/images/profile.jpg')} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    {
      profile.analytics.goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${profile.analytics.goatcounter}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <SiteHeader lang={lang} tab={tab} hasBeyond={hasBeyond} />
    <main id="main">
      <div class="main-inner"><slot /></div>
    </main>
    <SiteFooter lang={lang} profile={profile} />
    <script is:inline>
      // Reveal on view: see "Reveal on view" in global.css. Runs before first paint, so nothing flashes.
      (() => {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const io = new IntersectionObserver((entries) => {
          let n = 0;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.style.setProperty('--reveal-delay', Math.min(n++, 6) * 70 + 'ms');
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
        const targets = '.item, .featured-row, .values li, .tastes, .hobbies li, .section-title, main .label, main .chips, main .facts';
        for (const el of document.querySelectorAll(targets)) {
          if (el.parentElement.closest(targets)) continue; // e.g. tags inside a card rise with the card
          el.classList.add('reveal');
          io.observe(el);
        }
      })();
    </script>
  </body>
</html>
