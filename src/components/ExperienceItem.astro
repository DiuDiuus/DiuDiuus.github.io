---
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n/ui';
import { locText, tabPath, type Lang } from '../i18n/utils';
import { formatPeriod } from '../lib/dates';
import Card from './Card.astro';

interface Props {
  entry: CollectionEntry<'experience'>;
  lang: Lang;
  projectTitles: Map<string, string>;
}
const { entry, lang, projectTitles } = Astro.props;
const d = entry.data;
const text = locText(d.en, d.ko, lang);
const related = d.projects.filter((id) => projectTitles.has(id));
---

<Card id={entry.id}>
  <Fragment slot="head">
    <span class="s-title">{text.role}</span>
    <span class="s-meta">{text.org ?? d.org} · {formatPeriod(d.start, d.end, lang)}</span>
  </Fragment>
  {text.detail && <p class="s-lead">{text.detail}</p>}
  {d.location && <p class="muted">{d.location}</p>}
  {
    related.length > 0 && (
      <>
        <div class="label">
          <span>{t(lang, 'related')}</span>
        </div>
        <ul class="related">
          {related.map((id) => (
            <li>
              <a href={`${tabPath('projects', lang)}#${id}`}>{projectTitles.get(id)}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Card>
